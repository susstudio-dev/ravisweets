{
  "name": "ravisweets",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ravisweets/storefront dev",
    "build": "pnpm --filter @ravisweets/storefront run build:cloudflare",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "generate:seed": "node --import tsx scripts/generate-product-seed.mjs",
    "generate:catalogue": "node --import tsx scripts/generate-catalogue.mjs",
    "bake:catalogue": "node --import tsx scripts/bake-catalogue-from-source.mjs",
    "photography": "node scripts/photography/process.mjs",
    "photography:verify": "node --import tsx scripts/photography/verify.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.23.9",
    "typescript": "^5.6.3"
  }
}
